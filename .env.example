# Home Assistant base URL (use host.docker.internal if HA runs on the same machine)
HA_URL=http://homeassistant.local:8123
# Profile > Security > Long-lived access tokens
HA_TOKEN=paste-your-token-here
# Set to false if HA uses a self-signed certificate
VERIFY_SSL=true

TZ=Europe/London
UNIT=°C

# Sensors ticked by default (comma separated). Use your tado room sensors.
SENSORS=sensor.living_room_temperature,sensor.bedroom_temperature,sensor.hallway_temperature
# Outdoor temperature for context (tado provides one, or use your weather integration)
OUTDOOR_SENSOR=sensor.home_outdoor_temperature
# Hide sensors whose entity id contains any of these (e.g. the Meross ones that moved around)
EXCLUDE=meross

# Date the air-to-air system went live - used as the before/after split
INSTALL_DATE=2026-12-01
INSTALL_LABEL=Air-to-air installed

# --- Energy & cost tab ---
# Cumulative meters with long-term statistics (kWh, or m3 for gas). Comma separated.
# Find them under Developer tools > Statistics, or on the Energy tab's setup message.
ELECTRICITY_SENSORS=sensor.home_electricity_import
GAS_SENSORS=sensor.home_gas_consumption
# Unit rates in pence per kWh (placeholders: use your own tariff). Editable in the dashboard too.
ELEC_RATE_P=27.0
GAS_RATE_P=6.7
# Only used if your gas meter reports volume (m3) rather than kWh
GAS_KWH_PER_M3=11.1
